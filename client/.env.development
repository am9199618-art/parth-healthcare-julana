# Development defaults, committed on purpose.
#
# A fresh clone runs against the LIVE website and its live database
# (https://parth-health-care.web.app) straight away - there is no local
# server to configure and the website address never changes.
#
# These are Firebase *web app* values. They are public by design: they are
# already visible to every visitor of the live site in the page source, and
# they cannot read data on their own. Firestore security rules require a
# signed-in staff account before any record is readable.
#
# To run against a local Express database instead, create
# .env.development.local with:
#   VITE_DATA_BACKEND=api

VITE_FIREBASE_API_KEY=AIzaSyA8vsNhBb-TFlwqWBQDuJyy_7f-aSQy9C8
VITE_FIREBASE_AUTH_DOMAIN=parth-health-care.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=parth-health-care
VITE_FIREBASE_STORAGE_BUCKET=parth-health-care.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=749517469005
VITE_FIREBASE_APP_ID=1:749517469005:web:84c3394394febd5e567304

# Talk to the live Firestore database, not a local one.
VITE_DATA_BACKEND=firestore
