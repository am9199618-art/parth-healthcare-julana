# Copy this file to .env.local and fill in the values.
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# These values are safe to commit in a public repo ONLY if security rules protect
# your data (which firestore.rules does). Never put service account keys here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Which backend the app talks to:
#   api        -> local Express server on http://localhost:4000
#   firestore  -> Firebase Firestore (used for the free hosted site)
# Leave unset to auto-select: firestore when Firebase is configured, otherwise api.
VITE_DATA_BACKEND=
